{
  "name": "odds-g2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:site": "vite --config vite.site.config.ts",
    "build": "tsc --noEmit && vite build",
    "build:site": "tsc --noEmit -p tsconfig.site.json && vite build --config vite.site.config.ts",
    "preview": "vite preview",
    "pack": "npm run build && evenhub pack app.json dist -o odds.ehpk && cp odds.ehpk site/public/odds.ehpk",
    "simulate": "evenhub-simulator --aid coreaudio:BuiltInMicrophoneDevice --automation-port 9898 http://127.0.0.1:5191",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.2.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  }
}
